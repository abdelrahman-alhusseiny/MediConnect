

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1f6feb" />
    <title>@ViewData["Title"] - MedicaCare</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MedicalSystem.WebUI.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css" />
</head>

<body>
    <div class="page-shell">
        <aside class="app-sidebar d-none d-lg-flex" aria-label="Primary navigation">
            <div class="sidebar-header">
                <a class="brand-pill" asp-area="" asp-controller="Home" asp-action="Index" aria-label="MedicaCare home">
                    <span class="brand-icon"><i class="bi bi-hospital"></i></span>
                    <span>MedicaCare</span>
                </a>
                <p class="sidebar-subtitle">Healthcare platform</p>
            </div>

            <nav class="sidebar-nav">
                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house-door"></i><span>Home</span>
                </a>

                @if (User.IsInRole(MedicalSystem.Utilities.Utilities.SD.Role_Admin))
                {
                    <a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2"></i><span>Admin dashboard</span></a>
                    <a class="nav-link" asp-area="Admin" asp-controller="Patient" asp-action="GetAllPatients"><i class="bi bi-people"></i><span>Patients</span></a>
                    <a class="nav-link" asp-area="Admin" asp-controller="Doctor" asp-action="GetAllDoctors"><i class="bi bi-person-badge"></i><span>Doctors</span></a>
                    <a class="nav-link" asp-area="Admin" asp-controller="Department" asp-action="GetAllDepartments"><i class="bi bi-building"></i><span>Departments</span></a>
                }

                @if (User.IsInRole(MedicalSystem.Utilities.Utilities.SD.Role_Patient))
                {
                    <a class="nav-link" asp-area="Patient" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2"></i><span>Dashboard</span></a>
                    <a class="nav-link" asp-area="Patient" asp-controller="Booking" asp-action="GetAllDoctors"><i class="bi bi-person-badge"></i><span>Doctors</span></a>
                    <a class="nav-link" asp-area="Patient" asp-controller="Appointment" asp-action="GetAllAppointments"><i class="bi bi-calendar-check"></i><span>Appointments</span></a>
                    <a class="nav-link" asp-area="Patient" asp-controller="History" asp-action="GetAllAppointments"><i class="bi bi-clock-history"></i><span>History</span></a>
                    <a class="nav-link" asp-area="Patient" asp-controller="Notification" asp-action="GetAllNotifications"><i class="bi bi-bell"></i><span>Notifications</span></a>
                    <a class="nav-link" asp-area="Patient" asp-controller="Profile" asp-action="GetProfile"><i class="bi bi-person-circle"></i><span>Profile</span></a>
                }

                @if (User.IsInRole(MedicalSystem.Utilities.Utilities.SD.Role_Doctor))
                {
                    <a class="nav-link" asp-area="Doctor" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2"></i><span>Dashboard</span></a>
                    <a class="nav-link" asp-area="Doctor" asp-controller="Clinic" asp-action="GetAllClinics"><i class="bi bi-hospital"></i><span>Clinics</span></a>
                    <a class="nav-link" asp-area="Doctor" asp-controller="Schedule" asp-action="GetAllSchedules"><i class="bi bi-calendar-week"></i><span>Schedules</span></a>
                    <a class="nav-link" asp-area="Doctor" asp-controller="Appointment" asp-action="GetAllAppointments"><i class="bi bi-calendar-check"></i><span>Appointments</span></a>
                    <a class="nav-link" asp-area="Doctor" asp-controller="History" asp-action="GetAllAppointments"><i class="bi bi-clock-history"></i><span>History</span></a>
                    <a class="nav-link" asp-area="Doctor" asp-controller="Review" asp-action="GetAllReviews"><i class="bi bi-chat-square-text"></i><span>Reviews</span></a>
                    <a class="nav-link" asp-area="Doctor" asp-controller="Notification" asp-action="GetAllNotifications"><i class="bi bi-bell"></i><span>Notifications</span></a>
                    <a class="nav-link" asp-area="Doctor" asp-controller="Profile" asp-action="GetProfile"><i class="bi bi-person-circle"></i><span>Profile</span></a>
                }

                @if (!User.Identity.IsAuthenticated)
                {
                    <a class="nav-link" asp-area="Identity" asp-controller="Account" asp-action="ChooseRole"><i class="bi bi-person-plus"></i><span>Register</span></a>
                    <a class="nav-link" asp-area="Identity" asp-controller="Account" asp-action="Login"><i class="bi bi-box-arrow-in-right"></i><span>Login</span></a>
                }
            </nav>

            <div class="sidebar-footer">
                <div class="sidebar-pill">
                    <i class="bi bi-shield-check"></i>
                    <span>Secure, compliant workflow</span>
                </div>
            </div>
        </aside>

        <div class="main-panel">
            <partial name="_HeaderPartial.cshtml" />
            <main role="main" class="main-content">
                @RenderBody()
            </main>
            <partial name="_FooterPartial.cshtml" />
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>
    <script>
        toastr.options = {
            closeButton: true,
            progressBar: true,
            positionClass: "toast-top-right",
            timeOut: "3000",
            extendedTimeOut: "1000"
        };
    </script>
    <partial name="_NotificationsPartial" />
</body>
</html>
