@{
    ViewData["Title"] = "Home";
}

<div class="container-fluid px-0">
    <!-- Hero Banner -->
    <section class="bg-light text-center py-5 mb-5 shadow-sm">
        <span class="badge rounded-pill bg-primary-subtle text-primary px-3 py-2 mb-3">Trusted medical experience</span>
        <h1 class="display-5 fw-bold mb-3">A premium healthcare platform for patients, doctors, and administrators.</h1>
        <p class="lead mb-4">Book care seamlessly, manage appointments with clarity, and maintain every interaction in a beautifully organized workspace.</p>
        <div class="d-flex justify-content-center flex-wrap gap-3">
            <a asp-area="Identity" asp-controller="Account" asp-action="ChooseRole" class="btn btn-primary fw-semibold">
                <i class="bi bi-person-plus me-2"></i> Register Now
            </a>
            <a asp-area="Identity" asp-controller="Account" asp-action="Login" class="btn btn-outline-primary fw-semibold">
                <i class="bi bi-box-arrow-in-right me-2"></i> Sign In
            </a>
        </div>
    </section>

    <!-- Feature Cards -->
    <section class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm p-4 h-100">
                <div class="metric-icon mb-3"><i class="bi bi-person-heart display-6 text-danger"></i></div>
                <h5 class="fw-semibold">Patient-first booking</h5>
                <p class="text-muted mb-0">Find specialists, compare clinics, and book visits in minutes with an effortless experience.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm p-4 h-100">
                <div class="metric-icon mb-3"><i class="bi bi-clipboard2-pulse display-6 text-warning"></i></div>
                <h5 class="fw-semibold">Smart coordination</h5>
                <p class="text-muted mb-0">Doctors and admins manage schedules, confirmations, and notices from a single polished portal.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm p-4 h-100">
                <div class="metric-icon mb-3"><i class="bi bi-stars display-6 text-info"></i></div>
                <h5 class="fw-semibold">Modern experience</h5>
                <p class="text-muted mb-0">Large typography, accessible controls, and responsive layouts keep every interaction comfortable.</p>
            </div>
        </div>
    </section>
</div>
