@model ECommerce.Models.ViewModels.ResetPasswordVM

@{
    ViewData["Title"] = "Reset Patient Password";
}

<div class="container py-4">
    <!-- Header -->
    <div class="bg-light p-4 mb-4 rounded shadow-sm">
        <h2 class="fw-bold mb-0"><i class="bi bi-key"></i> Reset Patient Password</h2>
        <p class="text-muted mb-0">Update login credentials securely for patient accounts.</p>
    </div>

    <!-- Reset Password Card -->
    <div class="card shadow-sm">
        <div class="card-header">
            <h5 class="fw-bold mb-0"><i class="bi bi-shield-lock"></i> Reset Password for @Model.AppUserEmail</h5>
        </div>

        <div class="card-body">
            <form asp-area="Admin" asp-controller="Patient" asp-action="ResetPatientPassword" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- Hidden Fields -->
                <input asp-for="Id" type="hidden" />
                <input asp-for="AppUserEmail" type="hidden" />
                <input asp-for="SourceView" type="hidden" />
                <input asp-for="SearchString" type="hidden" />
                <input asp-for="LockoutStatus" type="hidden" />
                <input asp-for="CurrentSort" type="hidden" />
                <input asp-for="CurrentPage" type="hidden" />

                <!-- New Password -->
                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label fw-bold"><i class="bi bi-key-fill"></i> New Password</label>
                    <input asp-for="NewPassword" class="form-control" />
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>

                <!-- Confirm Password -->
                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label fw-bold"><i class="bi bi-check2-circle"></i> Confirm New Password</label>
                    <input asp-for="ConfirmPassword" class="form-control" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <!-- Actions -->
                <div class="mt-4 text-end">
                    <button type="submit" class="btn btn-success me-2"><i class="bi bi-key"></i> Reset Password</button>
                    <a asp-area="Admin" asp-controller="Patient" asp-action="@Model.SourceView"
                       asp-route-id="@Model.Id"
                       asp-route-searchString="@Model.SearchString"
                       asp-route-lockoutStatus="@Model.LockoutStatus"
                       asp-route-currentSort="@Model.CurrentSort"
                       asp-route-currentPage="@Model.CurrentPage"
                       class="btn btn-secondary">
                        <i class="bi bi-arrow-left-circle"></i> Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
