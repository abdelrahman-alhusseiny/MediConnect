@model DepartmentVM

@{
    ViewData["Title"] = "Create Department";
}

<div class="container py-4">
    <!-- Header -->
    <div class="bg-light p-4 mb-4 rounded shadow-sm">
        <h2 class="fw-bold mb-0"><i class="bi bi-plus-circle"></i> Create Department</h2>
        <p class="text-muted mb-0">Add a new department to organize clinical care units.</p>
    </div>

    <!-- Create Department Form -->
    <div class="card shadow-sm p-4">
        <form asp-area="Admin" asp-controller="Department" asp-action="CreateDepartment" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- Hidden Fields -->
            <input asp-for="SearchString" type="hidden" />
            <input asp-for="CurrentSort" type="hidden" />
            <input asp-for="CurrentPage" type="hidden" />

            <!-- Department Name -->
            <div class="mb-3">
                <label asp-for="Department.Name" class="form-label fw-bold"><i class="bi bi-tag"></i> Department Name</label>
                <input asp-for="Department.Name" class="form-control" />
                <span asp-validation-for="Department.Name" class="text-danger"></span>
            </div>

            <!-- Department Description -->
            <div class="mb-3">
                <label asp-for="Department.Description" class="form-label fw-bold"><i class="bi bi-info-circle"></i> Department Description</label>
                <textarea asp-for="Department.Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Department.Description" class="text-danger"></span>
            </div>

            <!-- Actions -->
            <div class="mt-4 d-flex justify-content-between">
                <button type="submit" class="btn btn-success"><i class="bi bi-check-circle"></i> Save</button>
                <a asp-area="Admin" asp-controller="Department" asp-action="GetAllDepartments"
                   asp-route-searchString="@Model.SearchString"
                   asp-route-currentSort="@Model.CurrentSort"
                   asp-route-currentPage="@Model.CurrentPage"
                   class="btn btn-secondary">
                    <i class="bi bi-arrow-left-circle"></i> Back
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
