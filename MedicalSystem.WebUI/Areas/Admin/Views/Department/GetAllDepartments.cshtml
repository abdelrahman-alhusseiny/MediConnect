@model DepartmentIndexVM

@{
    ViewData["Title"] = "Department List";
}

<div class="container py-4">
    <!-- Header -->
    <div class="bg-light p-4 mb-4 rounded shadow-sm d-flex justify-content-between align-items-center">
        <div>
            <h2 class="fw-bold mb-2"><i class="bi bi-list-ul"></i> Department List</h2>
            <p class="text-muted mb-0">Manage clinical departments with a clear, organized view of the available care units.</p>
        </div>
        <a asp-area="Admin" asp-controller="Department" asp-action="CreateDepartment"
           asp-route-searchString="@Model.SearchString"
           asp-route-currentSort="@Model.CurrentSort"
           asp-route-currentPage="@Model.CurrentPage" 
           class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Create New
        </a>
    </div>

    <!-- Filter Panel -->
    <div class="card p-3 mb-4 shadow-sm">
        <form asp-area="Admin" asp-controller="Department" asp-action="GetAllDepartments" method="get" class="row g-3 align-items-end">
            <input type="hidden" name="currentSort" value="@Model.CurrentSort" />
            <input type="hidden" name="currentPage" value="1" />

            <div class="col-md-6">
                <label class="form-label">Search departments</label>
                <input type="text" name="searchString" value="@Model.SearchString" class="form-control" placeholder="Search departments..." />
            </div>

            <div class="col-md-3">
                <a asp-area="Admin" asp-controller="Department" asp-action="GetAllDepartments" class="btn btn-outline-secondary w-100">
                    <i class="bi bi-arrow-counterclockwise"></i> Reset
                </a>
            </div>
        </form>
    </div>

    <!-- Sort Toolbar -->
    <div class="mb-3">
        <span class="fw-bold me-2">Sort by:</span>
        <a asp-area="Admin" asp-controller="Department" asp-action="GetAllDepartments"
           asp-route-currentSort="@Model.NameSort"
           asp-route-searchString="@Model.SearchString"
           asp-route-currentPage="@Model.CurrentPage"
           class="btn btn-sm btn-outline-primary me-2">
            Name
            @if (Model.CurrentSort == "name")
            {
                <i class="bi bi-caret-up-fill"></i>
            }
            else if (Model.CurrentSort == "name_desc")
            {

                <i class="bi bi-caret-down-fill"></i>
            }
        </a>
        <a asp-area="Admin" asp-controller="Department" asp-action="GetAllDepartments"
           asp-route-currentSort="@Model.CreatedAtSort"
           asp-route-searchString="@Model.SearchString"
           asp-route-currentPage="@Model.CurrentPage"
           class="btn btn-sm btn-outline-primary">
            Created At
            @if (Model.CurrentSort == "created")
            {
                <i class="bi bi-caret-up-fill"></i>
            }
            else if (Model.CurrentSort == "created_desc")
            {

                <i class="bi bi-caret-down-fill"></i>
            }
        </a>
    </div>

    <!-- Department Cards -->
    @if (!Model.Departments.Any())
    {
        <div class="alert alert-warning shadow-sm">
            <i class="bi bi-exclamation-triangle"></i> No departments available.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model.Departments)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body text-center">
                            <h5 class="fw-bold text-primary mb-2"><i class="bi bi-tag"></i> @item.Department.Name</h5>
                            <p class="text-muted mb-2"><i class="bi bi-clock-history"></i> @item.Department.CreatedAt.ToString("yyyy-MM-dd")</p>
                        </div>
                        <div class="card-footer d-flex flex-wrap gap-2 justify-content-center">
                            <a asp-area="Admin" asp-controller="Department" asp-action="GetDepartment" asp-route-id="@item.Department.Id"
                               asp-route-searchString="@Model.SearchString"
                               asp-route-currentSort="@Model.CurrentSort"
                               asp-route-currentPage="@Model.CurrentPage"
                               class="btn btn-sm btn-info"><i class="bi bi-eye"></i> Details</a>
                            <a asp-area="Admin" asp-controller="Department" asp-action="EditDepartment" asp-route-id="@item.Department.Id"
                               asp-route-searchString="@Model.SearchString"
                               asp-route-currentSort="@Model.CurrentSort"
                               asp-route-currentPage="@Model.CurrentPage"
                               class="btn btn-sm btn-warning"><i class="bi bi-pencil-square"></i> Edit</a>
                            <a asp-area="Admin" asp-controller="Department" asp-action="DeleteDepartment" asp-route-id="@item.Department.Id"
                               asp-route-searchString="@Model.SearchString"
                               asp-route-currentSort="@Model.CurrentSort"
                               asp-route-currentPage="@Model.CurrentPage"
                               class="btn btn-sm btn-danger"><i class="bi bi-trash"></i> Delete</a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a asp-area="Admin" asp-controller="Department" asp-action="GetAllDepartments"
                           asp-route-currentPage="@i"
                           asp-route-searchString="@Model.SearchString"
                           asp-route-currentSort="@Model.CurrentSort"
                           class="page-link">
                            @i
                           </a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>
