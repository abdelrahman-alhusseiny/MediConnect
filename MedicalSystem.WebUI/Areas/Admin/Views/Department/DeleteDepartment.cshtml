@model DepartmentVM

@{
    ViewData["Title"] = "Delete Department";
}

<div class="container py-4">
    <!-- Header -->
    <div class="bg-light p-4 mb-4 rounded shadow-sm">
        <h2 class="fw-bold text-danger mb-0"><i class="bi bi-trash"></i> Delete Department</h2>
        <p class="text-muted mb-0">Confirm deletion of this department. This action cannot be undone.</p>
    </div>

    <!-- Warning Alert -->
    <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <div>Are you sure you want to delete this department? This action cannot be undone.</div>
    </div>

    <!-- Info Grid -->
    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm p-3">
                <h6 class="fw-bold"><i class="bi bi-tag"></i> Name</h6>
                <p class="text-muted mb-0">@Model.Department.Name</p>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm p-3">
                <h6 class="fw-bold"><i class="bi bi-info-circle"></i> Description</h6>
                <p class="text-muted mb-0">@Model.Department.Description</p>
            </div>
        </div>
        <div class="col-md-12">
            <div class="card shadow-sm p-3">
                <h6 class="fw-bold"><i class="bi bi-clock-history"></i> Account Created On</h6>
                <p class="text-muted mb-0">@Model.Department.CreatedAt.ToString("yyyy-MM-dd")</p>
            </div>
        </div>
    </div>

    <!-- Delete Form -->
    <div class="card shadow-sm">
        <div class="card-footer d-flex flex-wrap gap-2 justify-content-end">
            <form asp-area="Admin" asp-controller="Department" asp-action="DeleteDepartment" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input asp-for="Department.Id" type="hidden" />
                <input asp-for="SearchString" type="hidden" />
                <input asp-for="CurrentSort" type="hidden" />
                <input asp-for="CurrentPage" type="hidden" />
                <button type="submit" class="btn btn-danger"><i class="bi bi-trash-fill"></i> Yes, Delete</button>
            </form>
            <a asp-area="Admin" asp-controller="Department" asp-action="GetAllDepartments"
               asp-route-searchString="@Model.SearchString"
               asp-route-currentSort="@Model.CurrentSort"
               asp-route-currentPage="@Model.CurrentPage"
               class="btn btn-secondary"><i class="bi bi-x-circle"></i> Cancel</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
