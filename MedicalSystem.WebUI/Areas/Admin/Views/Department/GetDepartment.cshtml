@model DepartmentVM

@{
    ViewData["Title"] = "Department Details";
}

<div class="container py-4">
    <!-- Header -->
    <div class="bg-light p-4 mb-4 rounded shadow-sm">
        <h2 class="fw-bold mb-0"><i class="bi bi-info-circle"></i> Department Details</h2>
        <p class="text-muted mb-0">View department information and manage actions.</p>
    </div>

    <!-- Info Grid -->
    <div class="row g-4">
        <div class="col-md-6">
            <div class="card shadow-sm p-3">
                <h6 class="fw-bold"><i class="bi bi-tag"></i> Name</h6>
                <p class="text-muted mb-0">@Model.Department.Name</p>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm p-3">
                <h6 class="fw-bold"><i class="bi bi-info-circle"></i> Description</h6>
                <p class="text-muted mb-0">@Model.Department.Description</p>
            </div>
        </div>
        <div class="col-md-12">
            <div class="card shadow-sm p-3">
                <h6 class="fw-bold"><i class="bi bi-clock-history"></i> Account Created On</h6>
                <p class="text-muted mb-0">@Model.Department.CreatedAt.ToString("yyyy-MM-dd")</p>
            </div>
        </div>
    </div>

    <!-- Actions -->
    <div class="card shadow-sm mt-4">
        <div class="card-footer d-flex flex-wrap gap-2 justify-content-end">
            <a asp-area="Admin" asp-controller="Department" asp-action="GetAllDepartments"
               asp-route-searchString="@Model.SearchString"
               asp-route-currentSort="@Model.CurrentSort"
               asp-route-currentPage="@Model.CurrentPage"
               class="btn btn-secondary"><i class="bi bi-arrow-left-circle"></i> Back to List</a>
            <a asp-area="Admin" asp-controller="Department" asp-action="EditDepartment"
               asp-route-id="@Model.Department.Id"
               asp-route-searchString="@Model.SearchString"
               asp-route-currentSort="@Model.CurrentSort"
               asp-route-currentPage="@Model.CurrentPage"
               class="btn btn-warning"><i class="bi bi-pencil-square"></i> Edit</a>
            <a asp-area="Admin" asp-controller="Department" asp-action="DeleteDepartment"
               asp-route-id="@Model.Department.Id"
               asp-route-searchString="@Model.SearchString"
               asp-route-currentSort="@Model.CurrentSort"
               asp-route-currentPage="@Model.CurrentPage"
               class="btn btn-danger"><i class="bi bi-trash"></i> Delete</a>
        </div>
    </div>
</div>
