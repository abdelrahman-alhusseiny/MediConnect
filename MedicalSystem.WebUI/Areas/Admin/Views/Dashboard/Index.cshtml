@using MedicalSystem.Models
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@inject MedicalSystem.DataAccess.Repository.IRepository.IUnitOfWork UnitOfWork

@{
    var appUser = await UserManager.GetUserAsync(User);
    var patients = await UnitOfWork.Patient.GetAllAsync();
    var doctors = await UnitOfWork.Doctor.GetAllAsync();
    var departments = await UnitOfWork.Department.GetAllAsync();
}

<div class="container-fluid py-4">
    <!-- Hero Banner -->
    <div class="bg-light p-4 mb-4 rounded shadow-sm">
        <span class="badge bg-primary-subtle text-primary px-3 py-2 mb-3">Operations Center</span>
        <h1 class="fw-bold mb-2">Admin Dashboard</h1>
        <p class="text-muted mb-0">Welcome back, @appUser?.UserName. Monitor care delivery, staff, and platform operations from one refined workspace.</p>
    </div>

    <!-- Navigation Cards -->
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card shadow-sm p-4 h-100 text-center">
                <i class="bi bi-people display-4 text-primary"></i>
                <h5 class="mt-3">Patients</h5>
                <p class="text-muted">Review and manage all registered patients in one place.</p>
                <a asp-area="Admin" asp-controller="Patient" asp-action="GetAllPatients" class="btn btn-outline-primary w-100">Manage Patients</a>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm p-4 h-100 text-center">
                <i class="bi bi-person-badge display-4 text-success"></i>
                <h5 class="mt-3">Doctors</h5>
                <p class="text-muted">Coordinate physician profiles, departments, and practice visibility.</p>
                <a asp-area="Admin" asp-controller="Doctor" asp-action="GetAllDoctors" class="btn btn-outline-success w-100">Manage Doctors</a>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm p-4 h-100 text-center">
                <i class="bi bi-building display-4 text-warning"></i>
                <h5 class="mt-3">Departments</h5>
                <p class="text-muted">Create and organize expert care departments for your medical network.</p>
                <a asp-area="Admin" asp-controller="Department" asp-action="GetAllDepartments" class="btn btn-outline-warning w-100">Manage Departments</a>
            </div>
        </div>
    </div>
</div>
