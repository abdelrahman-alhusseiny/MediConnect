@model ClinicVM

@{
    ViewData["Title"] = "Delete Clinic";
}

<div class="container py-4">
    <!-- Header -->
    <div class="bg-light p-4 mb-4 rounded shadow-sm">
        <h2 class="fw-bold text-danger mb-0"><i class="bi bi-trash"></i> Delete Clinic</h2>
        <p class="text-muted mb-0">This action is permanent and cannot be undone.</p>
    </div>

    <!-- Warning Alert -->
    <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <div>Are you sure you want to delete this clinic?</div>
    </div>

    <!-- Clinic Info -->
    <div class="card shadow-sm p-4 mb-4">
        <div class="row g-3">
            <div class="col-md-6">
                <h6 class="fw-bold"><i class="bi bi-tag"></i> Name</h6>
                <p class="text-muted mb-0">@Model.Clinic.Name</p>
            </div>
            <div class="col-md-6">
                <h6 class="fw-bold"><i class="bi bi-geo-alt"></i> Address</h6>
                <p class="text-muted mb-0">@Model.Clinic.Address</p>
            </div>
            <div class="col-md-6">
                <h6 class="fw-bold"><i class="bi bi-phone"></i> Phone Number</h6>
                <p class="text-muted mb-0">@Model.Clinic.PhoneNumber</p>
            </div>
            <div class="col-md-6">
                <h6 class="fw-bold"><i class="bi bi-currency-exchange"></i> Consultation Price</h6>
                <p class="text-success fw-bold mb-0">@Model.Clinic.ConsultationPrice.ToString("C")</p>
            </div>
            <div class="col-md-12">
                <h6 class="fw-bold"><i class="bi bi-clock-history"></i> Account Created On</h6>
                <p class="text-muted mb-0">@Model.Clinic.CreatedAt.ToString("yyyy-MM-dd")</p>
            </div>
        </div>
    </div>

    <!-- Delete Form -->
    <form asp-area="Doctor" asp-controller="Clinic" asp-action="DeleteClinic" method="post" class="d-flex flex-wrap gap-2 justify-content-end">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

        <input asp-for="Clinic.Id" type="hidden" />
        <input asp-for="SearchString" type="hidden" />
        <input asp-for="CurrentSort" type="hidden" />
        <input asp-for="CurrentPage" type="hidden" />

        <button type="submit" class="btn btn-danger"><i class="bi bi-trash-fill"></i> Yes, Delete</button>
        <a asp-area="Doctor" asp-controller="Clinic" asp-action="@Model.SourceView"
           asp-route-id="@Model.Clinic.Id"
           asp-route-searchString="@Model.SearchString"
           asp-route-currentSort="@Model.CurrentSort"
           asp-route-currentPage="@Model.CurrentPage"
           class="btn btn-secondary"><i class="bi bi-x-circle"></i> Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
