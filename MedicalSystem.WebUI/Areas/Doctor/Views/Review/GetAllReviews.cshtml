@model DoctorReviewListVM

<div class="container py-4">
    <!-- Header -->
    <div class="card shadow-sm mb-4">
        <div class="card-body d-flex justify-content-between align-items-center">
            <h4 class="fw-bold mb-0"><i class="bi bi-chat-square-text"></i> Patient Reviews</h4>
            <div>
                <span class="fw-semibold">Average Rating:</span>
                @if (Model.AverageRating > 0)
                {
                    double avgRating = Model.AverageRating;
                    <span class="ms-2">
                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= (int)Math.Floor(avgRating))
                            {
                                <i class="bi bi-star-fill text-warning"></i>
                            }
                            else if (i == (int)Math.Ceiling(avgRating) && (avgRating - Math.Floor(avgRating)) > 0)
                            {
                                <i class="bi bi-star-half text-warning"></i>
                            }
                            else
                            {
                                <i class="bi bi-star text-warning"></i>
                            }
                        }
                    </span>
                }
                else
                {
                    <span class="text-muted ms-2">No reviews yet</span>
                }
            </div>
        </div>
    </div>

    <!-- Review Cards -->
    @if (Model.DoctorReviews != null && Model.DoctorReviews.Any())
    {
        <div class="row g-4">
            @foreach (var review in Model.DoctorReviews)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-3">
                                <img src="@review.PatientImageUrl"
                                     alt="Patient Image"
                                     class="rounded-circle shadow-sm me-2"
                                     style="width:40px; height:40px; object-fit:cover;" />
                                <h6 class="fw-bold mb-0">@review.PatientName</h6>
                            </div>
                            <div class="mb-2">
                                @{
                                    double rating = review.DoctorReview.Rating;
                                }
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= (int)Math.Floor(rating))
                                    {
                                        <i class="bi bi-star-fill text-warning"></i>
                                    }
                                    else if (i == (int)Math.Ceiling(rating) && (rating - Math.Floor(rating)) > 0)
                                    {
                                        <i class="bi bi-star-half text-warning"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-star text-warning"></i>
                                    }
                                }
                            </div>
                            <p class="text-muted fst-italic">
                                @if (!string.IsNullOrEmpty(review.DoctorReview.Comment))
                                {
                                    @review.DoctorReview.Comment
                                }
                                else
                                {
                                    <span class="text-muted">No comment provided</span>
                                }
                            </p>
                        </div>
                        <div class="card-footer text-end">
                            <small class="text-muted">@review.DoctorReview.CreatedAt.ToString("dd MMM yyyy")</small>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-warning shadow-sm">
            <i class="bi bi-exclamation-triangle"></i> No reviews have been submitted yet.
        </div>
    }
</div>
