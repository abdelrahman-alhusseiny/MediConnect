@model AppointmentListVM

@{
    ViewData["Title"] = "Appointment List";
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="bi bi-calendar-check"></i> Appointment List</h2>
    </div>

    <!-- Filter Panel -->
    <div class="card p-3 mb-4 shadow-sm">
        <form asp-area="Doctor" asp-controller="Appointment" asp-action="GetAllAppointments" method="get" class="row g-3 align-items-end">
            <input type="hidden" name="currentSort" value="@Model.CurrentSort" />
            <input type="hidden" name="currentPage" value="1" />

            <div class="col-md-4">
                <label class="form-label">Clinic</label>
                <select name="clinicId" asp-items="Model.ClinicList" class="form-select" onchange="this.form.submit()">
                    <option value="">All Clinics</option>
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label">Day</label>
                <select name="dayOfWeek" asp-items="Model.DayOfWeekList" class="form-select" onchange="this.form.submit()">
                    <option value="">All Days</option>
                </select>
            </div>

            <div class="col-md-4">
                <a asp-area="Doctor" asp-controller="Appointment" asp-action="GetAllAppointments" class="btn btn-outline-secondary w-100">
                    <i class="bi bi-arrow-counterclockwise"></i> Reset
                </a>
            </div>
        </form>
    </div>

    <!-- Sort Toolbar -->
    <div class="mb-3">
        <span class="fw-bold me-2">Sort by:</span>
        <a asp-area="Doctor" asp-controller="Appointment" asp-action="GetAllAppointments"
           asp-route-currentSort="@Model.PatientSort"
           asp-route-clinicId="@Model.ClinicId"
           asp-route-dayOfWeek="@Model.DayOfWeek"
           asp-route-currentPage="@Model.CurrentPage"
           class="btn btn-sm btn-outline-primary me-2">
            Patient Name
            @if (Model.CurrentSort == "patient")
            {
                <i class="bi bi-caret-up-fill"></i>
            }
            else if (Model.CurrentSort == "patient_desc")
            {

                <i class="bi bi-caret-down-fill"></i>
            }
        </a>
        <a asp-area="Doctor" asp-controller="Appointment" asp-action="GetAllAppointments"
           asp-route-currentSort="@Model.DateSort"
           asp-route-clinicId="@Model.ClinicId"
           asp-route-dayOfWeek="@Model.DayOfWeek"
           asp-route-currentPage="@Model.CurrentPage"
           class="btn btn-sm btn-outline-primary">
            Appointment Date
            @if (Model.CurrentSort == "date")
            {
                <i class="bi bi-caret-up-fill"></i>
            }
            else if (Model.CurrentSort == "date_desc")
            {

                <i class="bi bi-caret-down-fill"></i>
            }
        </a>
    </div>

    <!-- Appointment Cards -->
    @if (!Model.Appointments.Any())
    {
        <div class="alert alert-warning shadow-sm">
            <i class="bi bi-exclamation-triangle"></i> No appointments available.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model.Appointments)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title fw-bold text-primary">@item.ClinicName</h5>
                            <p class="mb-1"><i class="bi bi-person"></i> @item.Appointment.PatientName</p>
                            <p class="mb-1"><i class="bi bi-calendar-date"></i> @item.Appointment.AppointmentDate.ToString("dd/MM/yyyy")</p>
                            <p class="mb-1"><i class="bi bi-clock"></i> @DateTime.Today.Add(item.Appointment.AppointmentTime).ToString("hh:mm tt")</p>
                            <p class="mb-1"><i class="bi bi-credit-card"></i> @item.Appointment.PaymentMethod</p>
                            <p class="mb-0">
                                <span class="badge @(item.Appointment.Status == "Pending" ? "bg-warning text-dark" :
                                                                          item.Appointment.Status == "Confirmed" ? "bg-info text-dark" :
                                                                          item.Appointment.Status == "Completed" ? "bg-success" :
                                                                          item.Appointment.Status == "Cancelled" ? "bg-danger" : "bg-secondary")">
                            @item.Appointment.Status
                        </span>
                    </p>
                </div>
                <div class="card-footer d-flex flex-wrap gap-2">
                    <a asp-area="Doctor" asp-controller="Appointment" asp-action="GetAppointment" asp-route-id="@item.Appointment.Id"
                       asp-route-clinicId="@Model.ClinicId"
                       asp-route-dayOfWeek="@Model.DayOfWeek"
                       asp-route-currentSort="@Model.CurrentSort"
                       asp-route-currentPage="@Model.CurrentPage"
                       class="btn btn-sm btn-info"><i class="bi bi-eye"></i> Details</a>

                    @if (item.IsPending)
                            {
                                <form asp-area="Doctor" asp-controller="Appointment" asp-action="CancelAppointment" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="Appointment.id" value="@item.Appointment.Id" />
                                    <input type="hidden" name="sourceView" value="@Model.SourceView" />
                                    <input type="hidden" name="clinicId" value="@Model.ClinicId" />
                                    <input type="hidden" name="dayOfWeek" value="@Model.DayOfWeek" />
                                    <input type="hidden" name="currentSort" value="@Model.CurrentSort" />
                                    <input type="hidden" name="currentPage" value="@Model.CurrentPage" />
                                    <button type="submit" class="btn btn-sm btn-danger"><i class="bi bi-x-circle"></i> Cancel</button>
                                </form>
                                <form asp-area="Doctor" asp-controller="Appointment" asp-action="ConfirmAppointment" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="Appointment.id" value="@item.Appointment.Id" />
                                    <input type="hidden" name="sourceView" value="@Model.SourceView" />
                                    <input type="hidden" name="clinicId" value="@Model.ClinicId" />
                                    <input type="hidden" name="dayOfWeek" value="@Model.DayOfWeek" />
                                    <input type="hidden" name="currentSort" value="@Model.CurrentSort" />
                                    <input type="hidden" name="currentPage" value="@Model.CurrentPage" />
                                    <button type="submit" class="btn btn-sm btn-success"><i class="bi bi-check-circle"></i> Confirm</button>
                                </form>
                            }
                            else if (item.CanBeCompleted)
                            {
                                <form asp-area="Doctor" asp-controller="Appointment" asp-action="CompleteAppointment" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="Appointment.id" value="@item.Appointment.Id" />
                                    <input type="hidden" name="sourceView" value="@Model.SourceView" />
                                    <input type="hidden" name="clinicId" value="@Model.ClinicId" />
                                    <input type="hidden" name="dayOfWeek" value="@Model.DayOfWeek" />
                                    <input type="hidden" name="currentSort" value="@Model.CurrentSort" />
                                    <input type="hidden" name="currentPage" value="@Model.CurrentPage" />
                                    <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-check2-all"></i> Complete</button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a asp-area="Doctor" asp-controller="Appointment" asp-action="GetAllAppointments"
                           asp-route-currentPage="@i"
                           asp-route-clinicId="@Model.ClinicId"
                           asp-route-dayOfWeek="@Model.DayOfWeek"
                           asp-route-currentSort="@Model.CurrentSort"
                           class="page-link">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>
