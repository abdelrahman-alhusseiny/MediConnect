@model NotificationListVM

@{
    ViewData["Title"] = "Notification List";
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold"><i class="bi bi-bell"></i> Notification List</h2>
    </div>

    <!-- Filter Panel -->
    <div class="card p-3 mb-4 shadow-sm">
        <form asp-area="Doctor" asp-controller="Notification" asp-action="GetAllNotifications" method="get" class="row g-3 align-items-end">
            <input type="hidden" name="currentSort" value="@Model.CurrentSort" />
            <input type="hidden" name="currentPage" value="1" />

            <div class="col-md-5">
                <label class="form-label">Search</label>
                <input type="text" name="searchString" value="@Model.SearchString" class="form-control" placeholder="Search notification..." />
            </div>

            <div class="col-md-4">
                <label class="form-label">Type</label>
                <select name="typeStatus" asp-items="Model.TypeStatusList" class="form-select" onchange="this.form.submit()">
                    <option value="">All Types</option>
                </select>
            </div>

            <div class="col-md-3">
                <a asp-area="Doctor" asp-controller="Notification" asp-action="GetAllNotifications" class="btn btn-outline-secondary w-100">
                    <i class="bi bi-arrow-counterclockwise"></i> Reset
                </a>
            </div>
        </form>
    </div>

    <!-- Sort Toolbar -->
    <div class="mb-3">
        <span class="fw-bold me-2">Sort by:</span>
        <a asp-area="Doctor" asp-controller="Notification" asp-action="GetAllNotifications"
           asp-route-currentSort="@Model.NameSort"
           asp-route-searchString="@Model.SearchString"
           asp-route-dayOfWeek="@Model.TypeStatus"
           asp-route-currentPage="@Model.CurrentPage"
           class="btn btn-sm btn-outline-primary me-2">
            Title
            @if (Model.CurrentSort == "name")
            {
                <i class="bi bi-caret-up-fill"></i>
            }
            else if (Model.CurrentSort == "name_desc")
            {

                <i class="bi bi-caret-down-fill"></i>
            }
        </a>
        <a asp-area="Doctor" asp-controller="Notification" asp-action="GetAllNotifications"
           asp-route-currentSort="@Model.CreatedAtSort"
           asp-route-searchString="@Model.SearchString"
           asp-route-dayOfWeek="@Model.TypeStatus"
           asp-route-currentPage="@Model.CurrentPage"
           class="btn btn-sm btn-outline-primary">
            Created At
            @if (Model.CurrentSort == "created")
            {
                <i class="bi bi-caret-up-fill"></i>
            }
            else if (Model.CurrentSort == "created_desc")
            {

                <i class="bi bi-caret-down-fill"></i>
            }
        </a>
    </div>

    <!-- Notification Cards -->
    @if (!Model.Notifications.Any())
    {
        <div class="alert alert-warning shadow-sm">
            <i class="bi bi-exclamation-triangle"></i> No notifications available.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model.Notifications)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title fw-bold text-primary">@item.Notification.Title</h5>
                            <p class="mb-2 text-muted">
                                @(item.Notification.Message.Length > 50 ? item.Notification.Message.Substring(0, 50) + "..." : item.Notification.Message)
                            </p>
                            <p class="mb-1"><i class="bi bi-tags"></i> @item.Notification.Type</p>
                            <p class="mb-1"><i class="bi bi-calendar-event"></i> @item.Notification.CreatedAt.ToString("yyyy-MM-dd")</p>
                            <p class="mb-0">
                                <span class="badge @(item.Notification.Status == SD.Status_Unreaded ? "bg-warning text-dark"
                                                                          : item.Notification.Status == SD.Status_Readed ? "bg-success"
                                                                          : "bg-secondary")">
                            @item.Notification.Status
                        </span>
                    </p>
                </div>
                <div class="card-footer d-flex justify-content-between">
                    <a asp-area="Doctor" asp-controller="Notification" asp-action="GetNotification" asp-route-id="@item.Notification.Id"
                       asp-route-searchString="@Model.SearchString"
                       asp-route-typeStatus="@Model.TypeStatus"
                       asp-route-currentSort="@Model.CurrentSort"
                       asp-route-currentPage="@Model.CurrentPage"
                       class="btn btn-sm btn-info"><i class="bi bi-eye"></i> Details</a>
                    <form asp-area="Doctor" asp-controller="Notification" asp-action="DiscardNotification" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="Notification.id" value="@item.Notification.Id" />
                        <input type="hidden" name="searchString" value="@Model.SearchString" />
                        <input type="hidden" name="lockoutStatus" value="@Model.TypeStatus" />
                        <input type="hidden" name="currentSort" value="@Model.CurrentSort" />
                        <input type="hidden" name="currentPage" value="@Model.CurrentPage" />
                        <button type="submit" class="btn btn-sm btn-danger"><i class="bi bi-x-circle"></i> Discard</button>
                    </form>
                </div>
            </div>
        </div>
                }
        </div>

        <!-- Pagination -->
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a asp-area="Doctor" asp-controller="Notification" asp-action="GetAllNotifications"
                           asp-route-currentPage="@i"
                           asp-route-searchString="@Model.SearchString"
                           asp-route-typeStatus="@Model.TypeStatus"
                           asp-route-currentSort="@Model.CurrentSort"
                           class="page-link">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>
