@model ScheduleVM

@{
    ViewData["Title"] = "Schedule Details";
}

<div class="container py-4">
    <!-- Header -->
    <div class="bg-light p-4 mb-4 rounded shadow-sm">
        <h2 class="fw-bold mb-0"><i class="bi bi-info-circle"></i> Schedule Details</h2>
        <p class="text-muted mb-0">Review clinic schedule information and manage actions.</p>
    </div>

    <!-- Schedule Details Card -->
    <div class="card shadow-sm p-4">
        <div class="row g-3">
            <div class="col-md-6">
                <h6 class="fw-bold"><i class="bi bi-hospital"></i> Clinic</h6>
                <p class="text-muted mb-0">@Model.ClinicName</p>
            </div>
            <div class="col-md-6">
                <h6 class="fw-bold"><i class="bi bi-calendar-week"></i> Day Of Week</h6>
                <p class="text-muted mb-0">@Model.Schedule.DayOfWeek</p>
            </div>
            <div class="col-md-6">
                <h6 class="fw-bold"><i class="bi bi-clock"></i> Start Time</h6>
                <p class="text-muted mb-0">@DateTime.Today.Add(Model.Schedule.StartTime).ToString("hh:mm tt")</p>
            </div>
            <div class="col-md-6">
                <h6 class="fw-bold"><i class="bi bi-clock-fill"></i> End Time</h6>
                <p class="text-muted mb-0">@DateTime.Today.Add(Model.Schedule.EndTime).ToString("hh:mm tt")</p>
            </div>
            <div class="col-md-6">
                <h6 class="fw-bold"><i class="bi bi-hourglass-split"></i> Appointment Duration</h6>
                <p class="text-muted mb-0">@Model.Schedule.AppointmentDuration minutes</p>
            </div>
            <div class="col-md-6">
                <h6 class="fw-bold"><i class="bi bi-people"></i> Max Patients Per Day</h6>
                <p class="text-muted mb-0">@Model.Schedule.MaxPatientsPerDay</p>
            </div>
            <div class="col-md-12">
                <h6 class="fw-bold"><i class="bi bi-sticky"></i> Notes</h6>
                <p class="text-muted mb-0">@Model.DisplayNotes</p>
            </div>
            <div class="col-md-12">
                <h6 class="fw-bold"><i class="bi bi-clock-history"></i> Created At</h6>
                <p class="text-muted mb-0">@Model.Schedule.CreatedAt.ToString("yyyy-MM-dd")</p>
            </div>
        </div>
    </div>

    <!-- Actions -->
    <div class="mt-4 d-flex flex-wrap gap-2">
        <a asp-area="Doctor" asp-controller="Schedule" asp-action="GetAllSchedules"
           asp-route-clinicId="@Model.ClinicId"
           asp-route-dayOfWeek="@Model.DayOfWeek"
           asp-route-currentSort="@Model.CurrentSort"
           asp-route-currentPage="@Model.CurrentPage"
           class="btn btn-secondary"><i class="bi bi-arrow-left-circle"></i> Back to List</a>

        <a asp-area="Doctor" asp-controller="Schedule" asp-action="EditSchedule"
           asp-route-id="@Model.Schedule.Id"
           asp-route-clinicId="@Model.ClinicId"
           asp-route-dayOfWeek="@Model.DayOfWeek"
           asp-route-sourceView="@Model.SourceView"
           asp-route-currentSort="@Model.CurrentSort"
           asp-route-currentPage="@Model.CurrentPage"
           class="btn btn-warning"><i class="bi bi-pencil-square"></i> Edit</a>

        <a asp-area="Doctor" asp-controller="Schedule" asp-action="DeleteSchedule"
           asp-route-id="@Model.Schedule.Id"
           asp-route-clinicId="@Model.ClinicId"
           asp-route-dayOfWeek="@Model.DayOfWeek"
           asp-route-sourceView="@Model.SourceView"
           asp-route-currentSort="@Model.CurrentSort"
           asp-route-currentPage="@Model.CurrentPage"
           class="btn btn-danger"><i class="bi bi-trash"></i> Delete</a>
    </div>
</div>
