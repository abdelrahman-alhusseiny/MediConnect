@model ScheduleListVM

@{
    ViewData["Title"] = "Schedule List";
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold"><i class="bi bi-calendar-week"></i> Schedule List</h2>
            <p class="text-muted mb-0">Review and organize clinic availability with a clear weekly planning view.</p>
        </div>
        <a asp-area="Doctor" asp-controller="Schedule" asp-action="CreateSchedule"
           asp-route-clinicId="@Model.ClinicId"
           asp-route-dayOfWeek="@Model.DayOfWeek"
           asp-route-currentSort="@Model.CurrentSort"
           asp-route-currentPage="@Model.CurrentPage"
           class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Create New
        </a>
    </div>

    <!-- Filter Panel -->
    <div class="card p-3 mb-4 shadow-sm">
        <form asp-area="Doctor" asp-controller="Schedule" asp-action="GetAllSchedules" method="get" class="row g-3 align-items-end">
            <input type="hidden" name="currentSort" value="@Model.CurrentSort" />
            <input type="hidden" name="currentPage" value="1" />

            <div class="col-md-4">
                <label class="form-label">Clinic</label>
                <select name="clinicId" asp-items="Model.ClinicList" class="form-select" onchange="this.form.submit()">
                    <option value="">All Clinics</option>
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label">Day</label>
                <select name="dayOfWeek" asp-items="Model.DayOfWeekList" class="form-select" onchange="this.form.submit()">
                    <option value="">All Days</option>
                </select>
            </div>

            <div class="col-md-4">
                <a asp-area="Doctor" asp-controller="Schedule" asp-action="GetAllSchedules" class="btn btn-outline-secondary w-100">
                    <i class="bi bi-arrow-counterclockwise"></i> Reset
                </a>
            </div>
        </form>
    </div>

    <!-- Sort Toolbar -->
    <div class="mb-3">
        <span class="fw-bold me-2">Sort by:</span>
        <a asp-area="Doctor" asp-controller="Schedule" asp-action="GetAllSchedules"
           asp-route-currentSort="@Model.DaySort"
           asp-route-clinicId="@Model.ClinicId"
           asp-route-dayOfWeek="@Model.DayOfWeek"
           asp-route-currentPage="@Model.CurrentPage"
           class="btn btn-sm btn-outline-primary me-2">
            Day of Week
            @if (Model.CurrentSort == "day")
            {
                <i class="bi bi-caret-up-fill"></i>
            }
            else if (Model.CurrentSort == "day_desc")
            {

                <i class="bi bi-caret-down-fill"></i>
            }
        </a>
        <a asp-area="Doctor" asp-controller="Schedule" asp-action="GetAllSchedules"
           asp-route-currentSort="@Model.CreatedAtSort"
           asp-route-clinicId="@Model.ClinicId"
           asp-route-dayOfWeek="@Model.DayOfWeek"
           asp-route-currentPage="@Model.CurrentPage"
           class="btn btn-sm btn-outline-primary">
            Created At
            @if (Model.CurrentSort == "created")
            {
                <i class="bi bi-caret-up-fill"></i>
            }
            else if (Model.CurrentSort == "created_desc")
            {

                <i class="bi bi-caret-down-fill"></i>
            }
        </a>
    </div>

    <!-- Schedule Cards -->
    @if (!Model.Schedules.Any())
    {
        <div class="alert alert-warning shadow-sm">
            <i class="bi bi-exclamation-triangle"></i> No schedules available.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model.Schedules)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title fw-bold text-primary">@item.ClinicName</h5>
                            <p class="mb-1"><i class="bi bi-calendar-week"></i> @item.Schedule.DayOfWeek</p>
                            <p class="mb-1"><i class="bi bi-clock"></i> @DateTime.Today.Add(item.Schedule.StartTime).ToString("hh:mm tt")</p>
                            <p class="mb-1"><i class="bi bi-clock-fill"></i> @DateTime.Today.Add(item.Schedule.EndTime).ToString("hh:mm tt")</p>
                            <p class="mb-0"><i class="bi bi-clock-history"></i> @item.Schedule.CreatedAt.ToString("yyyy-MM-dd")</p>
                        </div>
                        <div class="card-footer d-flex justify-content-between">
                            <a asp-area="Doctor" asp-controller="Schedule" asp-action="GetSchedule" asp-route-id="@item.Schedule.Id"
                               asp-route-clinicId="@Model.ClinicId"
                               asp-route-dayOfWeek="@Model.DayOfWeek"
                               asp-route-currentSort="@Model.CurrentSort"
                               asp-route-currentPage="@Model.CurrentPage"
                               class="btn btn-sm btn-info"><i class="bi bi-eye"></i> Details</a>
                            <a asp-area="Doctor" asp-controller="Schedule" asp-action="EditSchedule" asp-route-id="@item.Schedule.Id"
                               asp-route-clinicId="@Model.ClinicId"
                               asp-route-dayOfWeek="@Model.DayOfWeek"
                               asp-route-sourceView="@Model.SourceView"
                               asp-route-currentSort="@Model.CurrentSort"
                               asp-route-currentPage="@Model.CurrentPage"
                               class="btn btn-sm btn-warning"><i class="bi bi-pencil-square"></i> Edit</a>
                            <a asp-area="Doctor" asp-controller="Schedule" asp-action="DeleteSchedule" asp-route-id="@item.Schedule.Id"
                               asp-route-clinicId="@Model.ClinicId"
                               asp-route-dayOfWeek="@Model.DayOfWeek"
                               asp-route-sourceView="@Model.SourceView"
                               asp-route-currentSort="@Model.CurrentSort"
                               asp-route-currentPage="@Model.CurrentPage"
                               class="btn btn-sm btn-danger"><i class="bi bi-trash"></i> Delete</a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a asp-area="Doctor" asp-controller="Schedule" asp-action="GetAllSchedules"
                           asp-route-currentPage="@i"
                           asp-route-clinicId="@Model.ClinicId"
                           asp-route-dayOfWeek="@Model.DayOfWeek"
                           asp-route-currentSort="@Model.CurrentSort"
                           class="page-link">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>
