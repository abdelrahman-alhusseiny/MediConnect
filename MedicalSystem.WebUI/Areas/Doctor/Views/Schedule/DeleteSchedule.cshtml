@model ScheduleVM

@{
    ViewData["Title"] = "Delete Schedule";
}

<div class="container py-4">
    <!-- Header -->
    <div class="bg-light p-4 mb-4 rounded shadow-sm">
        <h2 class="fw-bold text-danger mb-0"><i class="bi bi-trash"></i> Delete Schedule</h2>
        <p class="text-muted mb-0">This action is permanent and cannot be undone.</p>
    </div>

    <!-- Warning Alert -->
    <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <div>Are you sure you want to delete this schedule?</div>
    </div>

    <!-- Schedule Info -->
    <div class="card shadow-sm p-4 mb-4">
        <div class="row g-3">
            <div class="col-md-6">
                <h6 class="fw-bold"><i class="bi bi-hospital"></i> Clinic</h6>
                <p class="text-muted mb-0">@Model.ClinicName</p>
            </div>
            <div class="col-md-6">
                <h6 class="fw-bold"><i class="bi bi-calendar-week"></i> Day Of Week</h6>
                <p class="text-muted mb-0">@Model.Schedule.DayOfWeek</p>
            </div>
            <div class="col-md-6">
                <h6 class="fw-bold"><i class="bi bi-clock"></i> Start Time</h6>
                <p class="text-muted mb-0">@DateTime.Today.Add(Model.Schedule.StartTime).ToString("hh:mm tt")</p>
            </div>
            <div class="col-md-6">
                <h6 class="fw-bold"><i class="bi bi-clock-fill"></i> End Time</h6>
                <p class="text-muted mb-0">@DateTime.Today.Add(Model.Schedule.EndTime).ToString("hh:mm tt")</p>
            </div>
            <div class="col-md-6">
                <h6 class="fw-bold"><i class="bi bi-hourglass-split"></i> Appointment Duration</h6>
                <p class="text-muted mb-0">@Model.Schedule.AppointmentDuration minutes</p>
            </div>
            <div class="col-md-6">
                <h6 class="fw-bold"><i class="bi bi-people"></i> Max Patients Per Day</h6>
                <p class="text-muted mb-0">@Model.Schedule.MaxPatientsPerDay</p>
            </div>
            <div class="col-md-12">
                <h6 class="fw-bold"><i class="bi bi-sticky"></i> Notes</h6>
                <p class="text-muted mb-0">@Model.DisplayNotes</p>
            </div>
            <div class="col-md-12">
                <h6 class="fw-bold"><i class="bi bi-clock-history"></i> Created At</h6>
                <p class="text-muted mb-0">@Model.Schedule.CreatedAt.ToString("yyyy-MM-dd")</p>
            </div>
        </div>
    </div>

    <!-- Delete Form -->
    <form asp-area="Doctor" asp-controller="Schedule" asp-action="DeleteSchedule" method="post" class="d-flex flex-wrap gap-2 justify-content-end">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

        <input asp-for="Schedule.Id" type="hidden" />
        <input asp-for="ClinicId" type="hidden" />
        <input asp-for="DayOfWeek" type="hidden" />
        <input asp-for="CurrentSort" type="hidden" />
        <input asp-for="CurrentPage" type="hidden" />

        <button type="submit" class="btn btn-danger"><i class="bi bi-trash-fill"></i> Yes, Delete</button>
        <a asp-area="Doctor" asp-controller="Schedule" asp-action="@Model.SourceView"
           asp-route-id="@Model.Schedule.Id"
           asp-route-clinicId="@Model.ClinicId"
           asp-route-dayOfWeek="@Model.DayOfWeek"
           asp-route-currentSort="@Model.CurrentSort"
           asp-route-currentPage="@Model.CurrentPage"
           class="btn btn-secondary"><i class="bi bi-x-circle"></i> Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
