@model LoginVM

@{
    ViewData["Title"] = "Login";
}

<div class="container py-4">
    <div class="row g-4 justify-content-center align-items-stretch">
        <!-- Welcome Card -->
        <div class="col-lg-5">
            <div class="card shadow-sm p-4 p-md-5 h-100">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="brand-icon"><i class="bi bi-heart-pulse text-danger"></i></span>
                    <h3 class="mb-0 fw-bold">Welcome Back</h3>
                </div>
                <p class="text-muted">Securely access your appointments, care plans, and notifications in one modern portal.</p>
                <ul class="list-unstyled mt-4">
                    <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> Fast booking and reminders</li>
                    <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> Accessible and mobile-ready</li>
                    <li><i class="bi bi-check-circle-fill text-success me-2"></i> Protected patient information</li>
                </ul>
            </div>
        </div>

        <!-- Login Card -->
        <div class="col-lg-6">
            <div class="card shadow-sm p-4 p-md-5">
                <h2 class="fw-bold mb-2"><i class="bi bi-box-arrow-in-right"></i> Sign In</h2>
                <p class="text-muted">Use your account to continue your healthcare journey.</p>

                <form asp-area="Identity" asp-controller="Account" asp-action="Login" method="post" class="mt-4" novalidate>
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                    <input type="hidden" asp-for="ReturnUrl" />

                    <!-- Email -->
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-bold"><i class="bi bi-envelope me-2"></i>Email</label>
                        <input asp-for="Email" class="form-control" autocomplete="email" aria-label="Email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <!-- Password -->
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-bold"><i class="bi bi-lock me-2"></i>Password</label>
                        <input asp-for="Password" class="form-control" type="password" autocomplete="current-password" aria-label="Password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <!-- Remember Me -->
                    <div class="form-check mb-3">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label">Keep me signed in</label>
                    </div>

                    <!-- Actions -->
                    <div class="d-flex flex-column flex-md-row justify-content-between gap-2 mt-4">
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-check-circle me-2"></i> Login
                        </button>
                        <a asp-area="Identity" asp-controller="Account" asp-action="ChooseRole" class="btn btn-secondary">
                            <i class="bi bi-person-plus me-2"></i> Register
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
