@model ECommerce.Models.ViewModels.ChangePasswordVM

@{
    ViewData["Title"] = "Change Account Password";
}

<div class="container py-4">
    <!-- Header -->
    <div class="bg-light p-4 mb-4 rounded shadow-sm">
        <h2 class="fw-bold mb-0"><i class="bi bi-key"></i> Change Account Password</h2>
        <p class="text-muted mb-0">Update your password to keep your account secure.</p>
    </div>

    <!-- Change Password Card -->
    <div class="card shadow-sm p-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="bi bi-shield-lock"></i> Change Password for @Model.AppUserEmail</h5>
        </div>

        <div class="card-body">
            <form asp-area="Patient" asp-controller="Profile" asp-action="ChangeAccountPassword" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input asp-for="AppUserEmail" type="hidden" />

                <!-- Current Password -->
                <div class="mb-3">
                    <label asp-for="CurrentPassword" class="form-label fw-bold"><i class="bi bi-lock-fill"></i> Current Password</label>
                    <input asp-for="CurrentPassword" class="form-control" type="password" placeholder="Enter current password" />
                    <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                </div>

                <!-- New Password -->
                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label fw-bold"><i class="bi bi-key-fill"></i> New Password</label>
                    <input asp-for="NewPassword" class="form-control" type="password" placeholder="Enter new password" />
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>

                <!-- Confirm Password -->
                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label fw-bold"><i class="bi bi-check2-circle"></i> Confirm New Password</label>
                    <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Re-enter new password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <!-- Actions -->
                <div class="mt-4 d-flex justify-content-between">
                    <button type="submit" class="btn btn-success"><i class="bi bi-check-circle"></i> Change Password</button>
                    <a asp-area="Patient" asp-controller="Profile" asp-action="GetProfile" class="btn btn-secondary"><i class="bi bi-arrow-left-circle"></i> Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
