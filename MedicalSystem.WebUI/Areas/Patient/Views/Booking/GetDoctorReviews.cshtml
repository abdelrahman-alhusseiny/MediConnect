@model DoctorReviewListVM

<div class="container py-4">
    <!-- Header -->
    <div class="card shadow-sm mb-4">
        <div class="card-body d-flex justify-content-between align-items-center">
            <h4 class="fw-bold mb-0"><i class="bi bi-chat-square-text"></i> Reviews for Doctor</h4>
        </div>
    </div>

    <!-- Review Cards -->
    @if (Model.DoctorReviews != null && Model.DoctorReviews.Any())
    {
        <div class="row g-4">
            @foreach (var review in Model.DoctorReviews)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-3">
                                <img src="@review.PatientImageUrl"
                                     alt="Patient Image"
                                     class="rounded-circle shadow-sm me-2"
                                     style="width:40px; height:40px; object-fit:cover;" />
                                <h6 class="fw-bold mb-0">@review.PatientName</h6>
                            </div>
                            <div class="mb-2">
                                @{
                                    double rating = review.DoctorReview.Rating;
                                }
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= (int)Math.Floor(rating))
                                    {
                                        <i class="bi bi-star-fill text-warning"></i>
                                    }
                                    else if (i == (int)Math.Ceiling(rating) && (rating - Math.Floor(rating)) > 0)
                                    {

                                        <i class="bi bi-star-half text-warning"></i>
                                    }
                                    else
                                    {

                                        <i class="bi bi-star text-warning"></i>
                                    }
                                }
                            </div>
                            <p class="text-muted fst-italic">
                                @if (!string.IsNullOrEmpty(review.DoctorReview.Comment))
                                {
                                    @review.DoctorReview.Comment
                                }
                                else
                                {
                                    <span class="text-muted">No comment provided</span>
                                }
                            </p>
                        </div>
                        <div class="card-footer text-end">
                            <small class="text-muted">@review.DoctorReview.CreatedAt.ToString("dd MMM yyyy")</small>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-warning shadow-sm">
            <i class="bi bi-exclamation-triangle"></i> No reviews yet for this doctor.
        </div>
    }

    <!-- Footer Actions -->
    <div class="card shadow-sm mt-4">
        <div class="card-footer text-end">
            @if (!Model.HasPatientReviewed)
            {
                <a asp-area="Patient" asp-controller="Booking" asp-action="CreateDoctorReview"
                   asp-route-doctorId="@Model.DoctorId"
                   asp-route-sourceView="@Model.SourceView"
                   asp-route-searchString="@Model.SearchString"
                   asp-route-departmentId="@Model.DepartmentId"
                   asp-route-currentSort="@Model.CurrentSort"
                   asp-route-currentPage="@Model.CurrentPage"
                   class="btn btn-warning me-2">
                    <i class="bi bi-star"></i> Add Review
                </a>
            }
            else
            {
                <a asp-area="Patient" asp-controller="Booking" asp-action="EditDoctorReview"
                   asp-route-doctorId="@Model.DoctorId"
                   asp-route-sourceView="@Model.SourceView"
                   asp-route-searchString="@Model.SearchString"
                   asp-route-departmentId="@Model.DepartmentId"
                   asp-route-currentSort="@Model.CurrentSort"
                   asp-route-currentPage="@Model.CurrentPage"
                   class="btn btn-primary me-2">
                    <i class="bi bi-pencil-square"></i> Edit My Review
                </a>
                <a asp-area="Patient" asp-controller="Booking" asp-action="DeleteDoctorReview"
                   asp-route-doctorId="@Model.DoctorId"
                   asp-route-sourceView="@Model.SourceView"
                   asp-route-searchString="@Model.SearchString"
                   asp-route-departmentId="@Model.DepartmentId"
                   asp-route-currentSort="@Model.CurrentSort"
                   asp-route-currentPage="@Model.CurrentPage"
                   class="btn btn-danger me-2">
                    <i class="bi bi-trash"></i> Delete My Review
                </a>
            }

            <a asp-area="Patient" asp-controller="Booking" asp-action="@Model.SourceView"
               asp-route-doctorId="@Model.DoctorId"
               asp-route-searchString="@Model.SearchString"
               asp-route-departmentId="@Model.DepartmentId"
               asp-route-currentSort="@Model.CurrentSort"
               asp-route-currentPage="@Model.CurrentPage"
               class="btn btn-secondary">
                <i class="bi bi-arrow-left-circle"></i> Back to List
            </a>
        </div>
    </div>
</div>
