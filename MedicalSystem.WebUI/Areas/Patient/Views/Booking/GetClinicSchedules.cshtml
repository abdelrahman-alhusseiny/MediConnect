@model ScheduleListVM

@{
    ViewData["Title"] = "Schedule List";
}

<div class="container py-4">
    <!-- Header -->
    <div class="bg-light p-4 mb-4 rounded shadow-sm d-flex justify-content-between align-items-center">
        <h2 class="fw-bold text-primary mb-0"><i class="bi bi-list-ul"></i> Schedule List</h2>
        <a asp-area="Patient" asp-controller="Booking" asp-action="GetDoctorClinics"
           asp-route-doctorId="@Model.DoctorId"
           class="btn btn-secondary">
            <i class="bi bi-arrow-left-circle"></i> Back to Clinics
        </a>
    </div>

    <!-- Filter Panel -->
    <div class="card p-3 mb-4 shadow-sm">
        <form asp-area="Patient" asp-controller="Booking" asp-action="GetClinicSchedules" method="get" class="row g-3 align-items-end">
            <input type="hidden" name="doctorId" value="@Model.DoctorId" />
            <input type="hidden" name="clinicId" value="@Model.ClinicId"
            <input type="hidden" name="currentSort" value="@Model.CurrentSort" />
            <input type="hidden" name="currentPage" value="1" />

            <div class="col-md-6">
                <label class="form-label">Day of Week</label>
                <select name="dayOfWeek" asp-items="Model.DayOfWeekList" class="form-select" onchange="this.form.submit()">
                    <option value="">All Days</option>
                </select>
            </div>

            <div class="col-md-3">
                <a asp-area="Patient" asp-controller="Booking" asp-action="GetClinicSchedules"
                   asp-route-doctorId="@Model.DoctorId"
                   asp-route-clinicId="@Model.ClinicId"
                   class="btn btn-outline-secondary w-100">
                    <i class="bi bi-arrow-counterclockwise"></i> Reset
                </a>
            </div>
        </form>
    </div>

    <!-- Sort Toolbar -->
    <div class="mb-3">
        <span class="fw-bold me-2">Sort by:</span>
        <a asp-area="Patient" asp-controller="Booking" asp-action="GetClinicSchedules"
           asp-route-currentSort="@Model.DaySort"
           asp-route-doctorId="@Model.DoctorId"
           asp-route-clinicId="@Model.ClinicId"
           asp-route-dayOfWeek="@Model.DayOfWeek"
           asp-route-currentPage="@Model.CurrentPage"
           class="btn btn-sm btn-outline-primary">
            Day of Week
            @if (Model.CurrentSort == "day")
            {
                <i class="bi bi-caret-up-fill"></i>
            }
            else if (Model.CurrentSort == "day_desc")
            {

                <i class="bi bi-caret-down-fill"></i>
            }
        </a>
    </div>

    <!-- Schedule Cards -->
    @if (!Model.Schedules.Any())
    {
        <div class="alert alert-warning shadow-sm">
            <i class="bi bi-exclamation-triangle"></i> No schedules available.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model.Schedules)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h5 class="fw-bold text-primary mb-2"><i class="bi bi-calendar-week"></i> @item.Schedule.DayOfWeek</h5>
                            <p class="mb-1"><i class="bi bi-clock"></i> Start: @DateTime.Today.Add(item.Schedule.StartTime).ToString("hh:mm tt")</p>
                            <p class="mb-1"><i class="bi bi-clock-fill"></i> End: @DateTime.Today.Add(item.Schedule.EndTime).ToString("hh:mm tt")</p>
                            <p class="mb-2"><i class="bi bi-hourglass-split"></i> Duration: @item.Schedule.AppointmentDuration minutes</p>
                            <p class="text-muted mb-3"><i class="bi bi-sticky"></i> @item.DisplayNotes</p>
                        </div>
                        <div class="card-footer text-center">
                            <a asp-area="Patient" asp-controller="Booking"
                               asp-action="AppointmentSummary"
                               asp-route-clinicId="@Model.ClinicId"
                               asp-route-doctorId="@Model.DoctorId"
                               asp-route-scheduleId="@item.Schedule.Id"
                               class="btn btn-success w-100">
                                <i class="bi bi-calendar-check"></i> Appointment Summary
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a asp-area="Patient" asp-controller="Booking" asp-action="GetClinicSchedules"
                           asp-route-currentPage="@i"
                           asp-route-doctorId="@Model.DoctorId"
                           asp-route-clinicId="@Model.ClinicId"
                           asp-route-dayOfWeek="@Model.DayOfWeek"
                           asp-route-currentSort="@Model.CurrentSort"
                           class="page-link">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>
