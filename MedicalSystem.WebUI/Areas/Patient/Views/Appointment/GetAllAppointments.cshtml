@model AppointmentListVM

@{
    ViewData["Title"] = "Appointment List";
}

<div class="container py-4">
    <!-- Header -->
    <div class="bg-light p-4 mb-4 rounded shadow-sm d-flex justify-content-between align-items-center">
        <div>
            <h2 class="fw-bold mb-2"><i class="bi bi-calendar-check"></i> Appointment List</h2>
            <p class="text-muted mb-0">Track upcoming visits, outstanding payments, and recent care plans.</p>
        </div>
        <div class="badge bg-primary-subtle text-primary"><i class="bi bi-shield-check"></i> Secure care tracking</div>
    </div>

    <!-- Filter Panel -->
    <div class="card p-3 mb-4 shadow-sm">
        <form asp-area="Patient" asp-controller="Appointment" asp-action="GetAllAppointments" method="get" class="row g-3 align-items-end">
            <input type="hidden" name="currentSort" value="@Model.CurrentSort" />
            <input type="hidden" name="currentPage" value="1" />

            <div class="col-md-5">
                <label class="form-label">Clinic or department</label>
                <input type="text" name="searchString" value="@Model.SearchString" class="form-control" placeholder="Search clinic name..." />
            </div>

            <div class="col-md-4">
                <label class="form-label">Day</label>
                <select name="dayOfWeek" asp-items="Model.DayOfWeekList" class="form-select" onchange="this.form.submit()">
                    <option value="">All Days</option>
                </select>
            </div>

            <div class="col-md-3">
                <a asp-area="Patient" asp-controller="Appointment" asp-action="GetAllAppointments" class="btn btn-outline-secondary w-100">
                    <i class="bi bi-arrow-counterclockwise"></i> Reset
                </a>
            </div>
        </form>
    </div>

    <!-- Sort Toolbar -->
    <div class="mb-3">
        <span class="fw-bold me-2">Sort by:</span>
        <a asp-area="Patient" asp-controller="Appointment" asp-action="GetAllAppointments"
           asp-route-currentSort="@Model.NameSort"
           asp-route-searchString="@Model.SearchString"
           asp-route-dayOfWeek="@Model.DayOfWeek"
           asp-route-currentPage="@Model.CurrentPage"
           class="btn btn-sm btn-outline-primary me-2">
            Clinic Name
            @if (Model.CurrentSort == "name")
            {
                <i class="bi bi-caret-up-fill"></i>
            }
            else if (Model.CurrentSort == "name_desc")
            {

                <i class="bi bi-caret-down-fill"></i>
            }
        </a>
        <a asp-area="Patient" asp-controller="Appointment" asp-action="GetAllAppointments"
           asp-route-currentSort="@Model.DateSort"
           asp-route-searchString="@Model.SearchString"
           asp-route-dayOfWeek="@Model.DayOfWeek"
           asp-route-currentPage="@Model.CurrentPage"
           class="btn btn-sm btn-outline-primary">
            Appointment Date
            @if (Model.CurrentSort == "date")
            {
                <i class="bi bi-caret-up-fill"></i>
            }
            else if (Model.CurrentSort == "date_desc")
            {

                <i class="bi bi-caret-down-fill"></i>
            }
        </a>
    </div>

    <!-- Appointment Cards -->
    @if (!Model.Appointments.Any())
    {
        <div class="alert alert-warning shadow-sm">
            <i class="bi bi-exclamation-triangle"></i> No appointments available at the moment.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model.Appointments)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h5 class="fw-bold text-primary mb-2"><i class="bi bi-building"></i> @item.DepartmentName</h5>
                            <p class="mb-1"><i class="bi bi-hospital"></i> @item.ClinicName</p>
                            <p class="mb-1"><i class="bi bi-calendar-week"></i> @item.AppointmentDay</p>
                            <p class="mb-1"><i class="bi bi-calendar-date"></i> @item.Appointment.AppointmentDate.ToString("dd/MM/yyyy")</p>
                            <p class="mb-1"><i class="bi bi-clock"></i> @DateTime.Today.Add(item.Appointment.AppointmentTime).ToString("hh:mm tt")</p>
                            <p class="mb-1"><i class="bi bi-credit-card"></i> @item.Appointment.PaymentMethod</p>
                            <p class="mb-2">
                                <span class="badge @(item.Appointment.Status == "Pending" ? "bg-warning text-dark" :
                                                                          item.Appointment.Status == "Confirmed" ? "bg-info text-dark" :
                                                                          item.Appointment.Status == "Completed" ? "bg-success" :
                                                                          item.Appointment.Status == "Cancelled" ? "bg-danger" : "bg-secondary")">
                            @item.Appointment.Status
                        </span>
                    </p>
                </div>
                <div class="card-footer d-flex flex-wrap gap-2">
                    <a asp-area="Patient" asp-controller="Appointment"
                       asp-action="GetAppointment" asp-route-id="@item.Appointment.Id"
                       asp-route-searchString="@Model.SearchString"
                       asp-route-dayOfWeek="@Model.DayOfWeek"
                       asp-route-currentSort="@Model.CurrentSort"
                       asp-route-currentPage="@Model.CurrentPage"
                       class="btn btn-sm btn-info"><i class="bi bi-eye"></i> Details</a>

                    @if (item.IsPending)
                            {
                                <a asp-area="Patient" asp-controller="Appointment"
                                   asp-action="EditAppointment" asp-route-id="@item.Appointment.Id"
                                   asp-route-sourceView="@Model.SourceView"
                                   asp-route-searchString="@Model.SearchString"
                                   asp-route-dayOfWeek="@Model.DayOfWeek"
                                   asp-route-currentSort="@Model.CurrentSort"
                                   asp-route-currentPage="@Model.CurrentPage"
                                   class="btn btn-sm btn-warning"><i class="bi bi-pencil-square"></i> Edit</a>
                                <a asp-area="Patient" asp-controller="Appointment"
                                   asp-action="CancelAppointment" asp-route-id="@item.Appointment.Id"
                                   asp-route-sourceView="@Model.SourceView"
                                   asp-route-searchString="@Model.SearchString"
                                   asp-route-dayOfWeek="@Model.DayOfWeek"
                                   asp-route-currentSort="@Model.CurrentSort"
                                   asp-route-currentPage="@Model.CurrentPage"
                                   class="btn btn-sm btn-danger"><i class="bi bi-x-circle"></i> Cancel</a>
                            }
                            else if (item.IsPayable)
                            {
                                <a asp-area="Patient" asp-controller="Appointment"
                                   asp-action="PayAppointmentByCard" asp-route-id="@item.Appointment.Id"
                                   asp-route-sourceView="@Model.SourceView"
                                   asp-route-searchString="@Model.SearchString"
                                   asp-route-dayOfWeek="@Model.DayOfWeek"
                                   asp-route-currentSort="@Model.CurrentSort"
                                   asp-route-currentPage="@Model.CurrentPage"
                                   class="btn btn-sm btn-success"><i class="bi bi-credit-card"></i> Pay Now</a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a asp-area="Patient" asp-controller="Appointment" asp-action="GetAllAppointments"
                           asp-route-currentPage="@i"
                           asp-route-searchString="@Model.SearchString"
                           asp-route-dayOfWeek="@Model.DayOfWeek"
                           asp-route-currentSort="@Model.CurrentSort"
                           class="page-link">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
</div>
