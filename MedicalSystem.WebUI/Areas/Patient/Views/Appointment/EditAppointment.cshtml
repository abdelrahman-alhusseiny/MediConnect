@model AppointmentVM

@{
    ViewData["Title"] = "Edit Appointment";
}

<div class="container py-4">
    <!-- Header -->
    <div class="bg-light p-4 mb-4 rounded shadow-sm">
        <h2 class="fw-bold mb-0"><i class="bi bi-pencil-square"></i> Edit Appointment</h2>
        <p class="text-muted mb-0">Update patient details, visit reason, and payment method.</p>
    </div>

    <!-- Edit Appointment Form -->
    <div class="card shadow-sm p-4">
        <form asp-area="Patient" asp-controller="Appointment" asp-action="EditAppointment" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <!-- Hidden Fields -->
            <input asp-for="Appointment.Id" type="hidden" />
            <input asp-for="Appointment.PatientImageUrl" type="hidden" />
            <input asp-for="PatientDisplayImageUrl" type="hidden" />
            <input asp-for="HasCustomImage" type="hidden" />
            <input asp-for="Appointment.Status" type="hidden" />
            <input asp-for="SourceView" type="hidden" />
            <input asp-for="SearchString" type="hidden" />
            <input asp-for="DayOfWeek" type="hidden" />
            <input asp-for="CurrentSort" type="hidden" />
            <input asp-for="CurrentPage" type="hidden" />

            <div class="row">
                <!-- Patient Image -->
                <div class="col-md-4 text-center">
                    <img src="@Model.PatientDisplayImageUrl" alt="Profile Image"
                         class="rounded-circle shadow-sm mb-3"
                         style="width:200px; height:200px; object-fit:cover;" />

                    @if (Model.HasCustomImage)
                    {
                        <div class="mt-2">
                            <button type="submit" asp-area="Patient" asp-controller="Appointment"
                                    asp-action="DeletePatientImage" class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-trash"></i> Remove Image
                            </button>
                        </div>
                    }

                    <div class="mt-3">
                        <label asp-for="Appointment.ImageFile" class="form-label fw-bold"><i class="bi bi-upload"></i> Upload New Image</label>
                        <input asp-for="Appointment.ImageFile" type="file" class="form-control" accept="image/*" />
                        <span asp-validation-for="Appointment.ImageFile" class="text-danger"></span>
                    </div>
                </div>

                <!-- Patient Info -->
                <div class="col-md-8">
                    <div class="mb-3">
                        <label asp-for="Appointment.PatientName" class="form-label fw-bold"><i class="bi bi-person"></i> Patient Name</label>
                        <input asp-for="Appointment.PatientName" class="form-control" placeholder="Enter name" />
                        <span asp-validation-for="Appointment.PatientName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Appointment.PatientPhoneNumber" class="form-label fw-bold"><i class="bi bi-telephone"></i> Patient Phone Number</label>
                        <input asp-for="Appointment.PatientPhoneNumber" class="form-control" placeholder="Enter phone number" />
                        <span asp-validation-for="Appointment.PatientPhoneNumber" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Appointment.PatientAddress" class="form-label fw-bold"><i class="bi bi-geo-alt"></i> Patient Address</label>
                        <textarea asp-for="Appointment.PatientAddress" class="form-control" rows="2" placeholder="Enter address"></textarea>
                        <span asp-validation-for="Appointment.PatientAddress" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Appointment.PatientGender" class="form-label fw-bold"><i class="bi bi-gender-ambiguous"></i> Patient Gender</label>
                        <select asp-for="Appointment.PatientGender" asp-items="Model.GenderList" class="form-select">
                            <option value="">-- Select Gender --</option>
                        </select>
                        <span asp-validation-for="Appointment.PatientGender" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Appointment.PatientAge" class="form-label fw-bold"><i class="bi bi-calendar"></i> Patient Age</label>
                        <input asp-for="Appointment.PatientAge" class="form-control" type="number" min="0" max="120" placeholder="Enter age" />
                        <span asp-validation-for="Appointment.PatientAge" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Appointment.ReasonForVisit" class="form-label fw-bold"><i class="bi bi-sticky"></i> Reason for Visit</label>
                        <textarea asp-for="Appointment.ReasonForVisit" class="form-control" rows="3" placeholder="e.g. headache, follow-up for diabetes"></textarea>
                        <span asp-validation-for="Appointment.ReasonForVisit" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Appointment.PaymentMethod" class="form-label fw-bold"><i class="bi bi-cash"></i> Payment Method</label>
                        <select asp-for="Appointment.PaymentMethod" asp-items="Model.PaymentMethodList" class="form-select">
                            <option value="">-- Select Payment Method --</option>
                        </select>
                        <span asp-validation-for="Appointment.PaymentMethod" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- Actions -->
            <div class="mt-4 d-flex justify-content-between">
                <button type="submit" class="btn btn-warning"><i class="bi bi-save"></i> Save Changes</button>
                <a asp-area="Patient" asp-controller="Appointment" asp-action="@Model.SourceView"
                   asp-route-id="@Model.Appointment.Id"
                   asp-route-searchString="@Model.SearchString"
                   asp-route-dayOfWeek="@Model.DayOfWeek"
                   asp-route-currentSort="@Model.CurrentSort"
                   asp-route-currentPage="@Model.CurrentPage"
                   class="btn btn-secondary"><i class="bi bi-x-circle"></i> Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
